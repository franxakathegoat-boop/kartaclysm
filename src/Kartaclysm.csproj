<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Kartaclysm</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.3.0</Version>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Assets\background.jpg" LogicalName="background.jpg" /><EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" /><EmbeddedResource Include="Assets\emblem.png" LogicalName="emblem.png" /><EmbeddedResource Include="Assets\cracks.png" LogicalName="cracks.png" /><EmbeddedResource Include="Assets\Rajdhani-Bold.ttf" LogicalName="bold.ttf" /><EmbeddedResource Include="Assets\Rajdhani-SemiBold.ttf" LogicalName="semi.ttf" /></ItemGroup>
</Project>
